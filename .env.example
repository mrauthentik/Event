# ==============================================================================
# Horemow International Holiness General Conference 2026
# Environment Variables Specification (.env.example)
# ==============================================================================

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Supabase PostgreSQL. Use the transaction pooler for the deployed app (port 6543).
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"
# Use the direct Supabase database host for schema migrations (port 5432).
MIGRATION_DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"
DB_POOL_SIZE="5"

# Redis (Upstash) - Rate Limiting & Reservations
UPSTASH_REDIS_REST_URL="https://example.upstash.io"
UPSTASH_REDIS_REST_TOKEN="mock_token_for_local_dev"

# Cloudflare Turnstile (Bot Protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Ticket Token Signing (Ed25519)
# Generate a random 32-byte private seed and derive its public key; never expose the private seed.
TICKET_SIGNING_PRIVATE_KEY=""
NEXT_PUBLIC_TICKET_VERIFYING_PUBLIC_KEY=""

# Payments: Paystack (NGN & USD/EUR/GBP if enabled)
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# Payments: PayPal (USD, EUR, GBP)
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_ENVIRONMENT="sandbox" # "sandbox" or "live"

# SMS Gateway (Termii)
TERMII_API_KEY=""
TERMII_SENDER_ID="HOREMOW"

# Transactional Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="IHGC 2026 <no-reply@horemow.org>"

# Inngest (Async Background Jobs)
INNGEST_EVENT_KEY="mock_inngest_event_key"
INNGEST_SIGNING_KEY="mock_inngest_signing_key"

# Staff / Admin Authentication
AUTH_SECRET="change-this-to-a-secure-random-32-byte-hex-secret"
CRON_SECRET="change-this-to-a-secure-random-secret"
SUPERVISOR_PIN="change-this-to-a-private-pin-of-at-least-8-characters"

