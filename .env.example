# ==============================================================================
# Horemow International Holiness General Conference 2026
# Environment Variables Specification (.env.example)
# ==============================================================================

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database (PostgreSQL - Neon / Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/horemow_events?sslmode=require"

# Redis (Upstash) - Rate Limiting & Reservations
UPSTASH_REDIS_REST_URL="https://example.upstash.io"
UPSTASH_REDIS_REST_TOKEN="mock_token_for_local_dev"

# Cloudflare Turnstile (Bot Protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Ticket Token Signing (HMAC-SHA256)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# TICKET_SIGNING_SECRET stays server-side only.
# NEXT_PUBLIC_TICKET_VERIFYING_SECRET is embedded in the scanner bundle — use the SAME value.
TICKET_SIGNING_SECRET=""
NEXT_PUBLIC_TICKET_VERIFYING_SECRET=""

# Payments: Paystack (NGN & USD/EUR/GBP if enabled)
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxx"

# Payments: PayPal (USD, EUR, GBP)
PAYPAL_CLIENT_ID="mock_paypal_client_id"
PAYPAL_CLIENT_SECRET="mock_paypal_client_secret"
PAYPAL_WEBHOOK_ID="mock_paypal_webhook_id"
PAYPAL_ENVIRONMENT="sandbox" # "sandbox" or "live"

# SMS Gateway (Termii)
TERMII_API_KEY="mock_termii_api_key"
TERMII_SENDER_ID="HOREMOW"

# Transactional Email (Resend)
RESEND_API_KEY="re_mock_api_key"
EMAIL_FROM="IHGC 2026 <no-reply@horemow.org>"

# Inngest (Async Background Jobs)
INNGEST_EVENT_KEY="mock_inngest_event_key"
INNGEST_SIGNING_KEY="mock_inngest_signing_key"

# Staff / Admin Authentication
AUTH_SECRET="change-this-to-a-secure-random-32-byte-hex-secret"

